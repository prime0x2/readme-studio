// Cloudflare Workers deployment: the built app in dist/ plus a small Worker
// (worker/index.ts) for the share-link API. `pnpm run deploy` builds and
// uploads both.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readme-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /view, /link, /gh/<owner>/<repo> and /s/<id> are client-side routes:
    // any path that isn't a file gets index.html.
    "not_found_handling": "single-page-application",
    // Only the API runs Worker code; every other request is a static asset.
    "run_worker_first": ["/api/*"]
  },
  // Encrypted share links (schema in migrations/). Create the database once
  // with `pnpm exec wrangler d1 create readme-studio` and paste its id here
  // (forks: create your own and replace this one).
  // Local dev (`pnpm dev:api`) uses a local copy and ignores the id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "readme-studio",
      "database_id": "1887af86-7c2e-43ed-8cf2-d408b539e6b9",
      "migrations_dir": "migrations"
    }
  ],
  // CREATE_LIMITER and OPEN_LIMITER are per client (the IP, or its /64 for
  // IPv6); SHARE_OPEN_LIMITER is per link. namespace_id is any number unique
  // within the Cloudflare account.
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "OPEN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    {
      "name": "SHARE_OPEN_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Daily purge of expired shares (UTC).
  "triggers": { "crons": ["17 3 * * *"] },
  // Production domain. Its zone must be on this Cloudflare account, and the
  // hostname must not already have a DNS record (remove the old A record
  // pointing at the VPS first) — Wrangler creates it on deploy.
  "routes": [{ "pattern": "readme.prime0x2.dev", "custom_domain": true }]
}
