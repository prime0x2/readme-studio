# Image proxy for DOCX export, used only when an image's host blocks CORS
# (the browser may show the image but not read it). "{url}" is replaced
# with the encoded image URL. Default: wsrv.nl (free, open source).
# Set to empty to disable, or point at your own proxy.
# VITE_IMAGE_PROXY=https://wsrv.nl/?url={url}&output=png

# Cloudflare Web Analytics beacon token (optional).
# VITE_CF_BEACON_TOKEN=
